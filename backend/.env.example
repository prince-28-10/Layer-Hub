# Layer Hub Backend Configuration
PORT=3000
HOST=0.0.0.0
# Storage directory for temporary retrieved media
STORAGE_DIR=./temp_storage
# Maximum video duration in seconds (Strict 3 minutes)
MAX_VIDEO_DURATION_SECONDS=180
# Temporary file retention period in milliseconds (Default: 15 minutes)
FILE_TTL_MS=900000
# Automatic cleanup interval in milliseconds (Default: 2 minutes)
CLEANUP_INTERVAL_MS=120000
# Optional Reddit API credentials (OAuth2 Installed App or Script)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=LayerHub/1.0

# Optional X (Twitter) API v2 credentials for media stream lookups
TWITTER_BEARER_TOKEN=

# Optional Meta Graph API credentials for Instagram & Facebook oEmbed
META_APP_ID=
META_CLIENT_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
